# ═══════════════════════════════════════════════════════════════
# ReviewHive — Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env.local (for local dev) or .env (for production reference).
# Auto-set vars (NODE_ENV, VERCEL_URL, NEXT_PHASE) are NOT listed — frameworks handle them.
#
# Generate secrets (pick any one):
#   Node.js : node -e "console.log(require('crypto').randomBytes(64).toString('base64url'))"
#   Python  : python -c "import secrets; print(secrets.token_urlsafe(64))"
#   OpenSSL : openssl rand -base64 64
# ═══════════════════════════════════════════════════════════════


# ─── 1. Database ────────────────────────────────────────────
# Primary connection — used by postgres.js (app queries at runtime)
# Production: postgresql://postgres.xxxxx:xxxxx@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Local:      postgresql://postgres:xxxxx@localhost:5432/reviewhive
DATABASE_URL=""

# Prisma migrations connection — needs DDL support (Session Pooler, not Transaction Pooler)
# Production: postgresql://postgres.xxxxx:xxxxx@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres
# Local:      same as DATABASE_URL (no pooler locally)
DIRECT_URL=""


# ─── 2. Auth / JWT ──────────────────────────────────────────
# Signs admin access tokens (15min TTL). Must be unique, min 32 chars.
# Production: generate with command above
# Local:      any random string
JWT_SECRET=""

# Signs admin refresh tokens (7d TTL). Must differ from JWT_SECRET.
# Production: generate with command above
# Local:      any random string (different from JWT_SECRET)
REFRESH_TOKEN_SECRET=""


# ─── 3. AI Providers ────────────────────────────────────────
# Comma-separated fallback chain: first available provider wins.
# Production: gemini,openai
# Local:      gemini,openai (or just one if you only have one key)
AI_PROVIDERS="gemini,openai"

# Optional: override default model per provider (gemini-2.5-flash / gpt-4o-mini)
# Uncomment to change:
# AI_MODEL="gemini-2.5-flash"

# Gemini API key — used for AI review generation + auto-reply
# Get from: https://aistudio.google.com/app/apikey
# Production: production key
# Local:      same key or dev key
GEMINI_API_KEY=""

# OpenAI API key — fallback if Gemini fails
# Get from: https://platform.openai.com/api-keys
# Production: org production key
# Local:      personal dev key
OPENAI_API_KEY=""


# ─── 4. Google OAuth (My Business API) ──────────────────────
# Required for: Google review sync + auto-reply posting
# Get from: https://console.cloud.google.com/apis/credentials

# Google OAuth client ID
# Production: production app credentials
# Local:      same app (add localhost to authorized origins in Google Console)
GOOGLE_CLIENT_ID=""

# Google OAuth client secret
# Production: production app credentials
# Local:      same as production
GOOGLE_CLIENT_SECRET=""

# OAuth callback URL — must match exactly in Google Console authorized redirect URIs
# Production: https://your-domain.vercel.app/api/admin/auto-reply/google/callback
# Local:      http://localhost:3000/api/admin/auto-reply/google/callback
GOOGLE_REDIRECT_URI=""


# ─── 5. Email (Gmail SMTP) ──────────────────────────────────
# Used for: password reset emails
# Gmail App Password: https://myaccount.google.com/apppasswords

# Gmail address used as sender
# Production: your-email@gmail.com
# Local:      same (or skip — password reset won't send locally)
GMAIL_USER=""

# Gmail App Password (NOT your Gmail login password)
# Production: 16-char app password from Google
# Local:      same
GMAIL_APP_PASSWORD=""


# ─── 6. Site URL ────────────────────────────────────────────
# Base URL for: QR codes, email links, OAuth callbacks
# NEXT_PUBLIC_ prefix = exposed to browser (safe — no secret)
# Falls back to VERCEL_URL (auto-set by Vercel) if blank.
# Production: https://your-domain.vercel.app
# Local:      http://localhost:3000
NEXT_PUBLIC_SITE_URL=""


# ─── 7. Vercel Cron ─────────────────────────────────────────
# Authenticates cron job requests (auto-reply daily trigger)
# Must match the value in Vercel dashboard → Settings → Environment Variables
# Production: strong random string
# Local:      any string (for manual testing with curl)
CRON_SECRET=""